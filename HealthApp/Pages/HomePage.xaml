<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HealthApp.HomePage"
             Shell.NavBarIsVisible="False">
   
   
     <Grid BackgroundColor="{StaticResource Secondary}">
         <Grid.RowDefinitions>
              <RowDefinition Height="160"  />
              <RowDefinition Height="*" />
              <RowDefinition Height="60" />
          </Grid.RowDefinitions>
        
    
        <VerticalStackLayout Padding="10,0,10, -20" VerticalOptions="StartAndExpand" Grid.Row="0" BackgroundColor="#007AFF">
            
            <!-- Greeting -->
            <HorizontalStackLayout HorizontalOptions="Start">
                <ImageButton HorizontalOptions="Start" Source="dp_icon.png" HeightRequest="50" WidthRequest="50"/>
                <Label HorizontalOptions="Start" Padding="20" FontSize="28" FontAttributes="Bold"
                   TextColor="White"  >
                    <Label.Text>
                        <MultiBinding StringFormat="Hello , {0} {1}">
                            <Binding Path="EmpDesig" />
                            <Binding Path="EmpName" />
                        </MultiBinding>
                    </Label.Text>
                    </Label>
            </HorizontalStackLayout>
            <!-- Quick Navigation Icons -->
                 <Frame CornerRadius="15" Padding="10" BackgroundColor="White">
                    <Grid ColumnSpacing="15" RowSpacing="10" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <ImageButton Source="appointments_icon.png" Command="{Binding ApntsCommand}"  HorizontalOptions="Center" />
                            <Label Text="Appointments" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <ImageButton Source="patients_icon.png" Command="{Binding PatientsCommand}"  HorizontalOptions="Center"/>
                            <Label Text="Patients" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <ImageButton Source="messages_icon.png" Command="{Binding MsgCommand}"  HorizontalOptions="Center" />
                            <Label Text="Messages" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                            <ImageButton Source="reports_icon.png" Command="{Binding ReportCommand}" HorizontalOptions="Center" />
                            <Label Text="Reports" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                 </Frame>
            </VerticalStackLayout>

               <ScrollView Grid.Row="1" VerticalOptions="StartAndExpand" BackgroundColor="{StaticResource Secondary}" Padding="10">

                     <Grid RowSpacing="5" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                     <!-- Today's Schedule -->
                      <Label Text="Today's Schedule" Grid.Row="0" FontSize="20" Padding="10" FontAttributes="Bold" TextColor="Black" />

                      <Frame CornerRadius="15" Grid.Row="1" Padding="15" BackgroundColor="white">
                         <CollectionView ItemsSource="{Binding Appointments}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="{Binding Time}" />
                                    <Label Grid.Column="1"
                                        Text="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                      </Frame>


                     <!-- Next Appointment -->
                
                    <Label Text="Next Appointment" Grid.Row="2" Padding="10" FontSize="20"   FontAttributes="Bold" TextColor="Black" />

                    <Frame CornerRadius="15" Padding="0" Grid.Row="3"  >
                         <Grid x:Name="NextApntsGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                              <Border Stroke="LightGray" StrokeThickness="3" StrokeShape="RoundRectangle 8" Grid.Row="0" BackgroundColor="{StaticResource Primary}">
                             <VerticalStackLayout BackgroundColor="{StaticResource Primary}" VerticalOptions="StartAndExpand" Padding="10,10,10,20"  >
                            <Label x:Name="nxtAptnDate" Text="{Binding NextAppointment.AptnDateLabel}" FontSize="14" FontAttributes="Bold" TextColor="White" />

                            <Label x:Name="nxtAptnDetails" Text="{Binding NextAppointment.AptnDetails}" FontSize="14" TextColor="White" />
                            </VerticalStackLayout>
                                  </Border>
                            <Button Grid.Row="1" IsEnabled="{Binding NextApntBtnEnabled}" Command="{Binding NextApntCommand}" BackgroundColor="White" Text="View Details" FontSize="15" TextColor="Black" HorizontalOptions="EndAndExpand" />
                           </Grid>
                        
                    </Frame>

                       
                    </Grid>
                     </ScrollView>
           

            <!-- Bottom Navigation -->
           
           
                 <Frame Grid.Row="2"  CornerRadius="15" Padding="10" BackgroundColor="White">
                   <Grid ColumnSpacing="15" RowSpacing="10" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ImageButton Grid.Column="0" Command="{Binding HomeCommand}" Source="home_icon.png" />
                        <ImageButton Grid.Column="1" Command="{Binding UserCommand}" Source="user_icon.png" />
                        <ImageButton Grid.Column="2" Command="{Binding PlayCommand}" Source="play_icon.png"  />
                        <ImageButton Grid.Column="3" Command="{Binding VideoCommand}" Source="video_icon.png"  />
                        <ImageButton Grid.Column="4"  Command="{Binding SettingsCommand}" Source="settings_icon.png" />
                     </Grid>
                </Frame>
           
      
   </Grid>
</ContentPage>

